# Supabase project URL (Project Settings → API). For local dev: http://127.0.0.1:54321
VITE_SUPABASE_URL=
# Supabase anon/publishable key (safe for the browser — RLS protects data). NEVER put the service-role key here.
VITE_SUPABASE_ANON_KEY=
# Public URL of this app, used to build invite links and auth redirects. e.g. http://localhost:5173
VITE_APP_URL=
